# --- LLM (required for live runs; cached demo runs without it) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=            # optional custom gateway
LLM_MODEL_REASONING=claude-sonnet-5
LLM_MODEL_EXTRACTION=claude-haiku-4-5

# --- Search provider: duckduckgo (keyless, default) | tavily | serper ---
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=

# --- Contact enrichment: ordered fallback chain ---
# Providers are tried in order; unconfigured ones are skipped, not fatal.
# With an Apollo key:  CONTACT_PROVIDERS=apollo,public_web,mock
CONTACT_PROVIDERS=public_web,mock
APOLLO_API_KEY=                # apollo.io -> real named decision-makers
CLAY_API_KEY=
CLAY_WEBHOOK_URL=
SALES_NAV_TOKEN=

# --- Pipeline ---
PIPELINE_MODE=cached             # cached | live
HTTP_CONCURRENCY=8
HTTP_TIMEOUT_S=20
HTTP_PER_HOST_DELAY_S=1.0
DATABASE_URL=sqlite:///./data/leads.db
